{
  "name": "@webergency-utils/typechecker",
  "version": "0.6.2",
  "type": "module",
  "description": "TypeScript compiler plugin for runtime validation",
  "author": "radixxko",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    },
    "./runtime/validators": {
      "import": {
        "types": "./dist/runtime/validators.d.ts",
        "default": "./dist/runtime/validators.js"
      },
      "require": {
        "types": "./dist/runtime/validators.d.cts",
        "default": "./dist/runtime/validators.cjs"
      }
    },
    "./runtime/parse": {
      "import": {
        "types": "./dist/runtime/parse-runtime.d.ts",
        "default": "./dist/runtime/parse-runtime.js"
      },
      "require": {
        "types": "./dist/runtime/parse-runtime.d.cts",
        "default": "./dist/runtime/parse-runtime.cjs"
      }
    },
    "./runtime/serialize": {
      "import": {
        "types": "./dist/runtime/serializer-runtime.d.ts",
        "default": "./dist/runtime/serializer-runtime.js"
      },
      "require": {
        "types": "./dist/runtime/serializer-runtime.d.cts",
        "default": "./dist/runtime/serializer-runtime.cjs"
      }
    },
    "./runtime/casing": {
      "import": {
        "types": "./dist/runtime/casing.d.ts",
        "default": "./dist/runtime/casing.js"
      },
      "require": {
        "types": "./dist/runtime/casing.d.cts",
        "default": "./dist/runtime/casing.cjs"
      }
    },
    "./runtime/path": {
      "import": {
        "types": "./dist/runtime/path.d.ts",
        "default": "./dist/runtime/path.js"
      },
      "require": {
        "types": "./dist/runtime/path.d.cts",
        "default": "./dist/runtime/path.cjs"
      }
    },
    "./runtime/regex": {
      "import": {
        "types": "./dist/runtime/regex.d.ts",
        "default": "./dist/runtime/regex.js"
      },
      "require": {
        "types": "./dist/runtime/regex.d.cts",
        "default": "./dist/runtime/regex.cjs"
      }
    },
    "./transformer": {
      "import": {
        "types": "./dist/transformer.d.ts",
        "default": "./dist/transformer.js"
      },
      "require": {
        "types": "./dist/transformer.d.cts",
        "default": "./dist/transformer.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "bench": "npm run build && node scripts/perf-microbench.mjs",
    "fuzz": "npm run build:fuzz && jazzer fuzz/typechecker.cjs",
    "coverage": "npm run build && vitest run --coverage",
    "clean": "rm -rf ./dist ./dist-fuzz",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm i",
    "build": "npm run clean && tsup",
    "build:fuzz": "esbuild fuzz/runtime.ts --bundle --platform=node --format=cjs --outfile=dist-fuzz/runtime.cjs",
    "commit": "node -e \"const version = require('./package.json').version.trim(); require('child_process').execSync('git add . && git commit -m \\\"Version ' + version + '\\\"');\"",
    "version": "npm run build && npm publish --access public && npm run commit && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/typechecker.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/typechecker/issues"
  },
  "homepage": "https://github.com/webergency-utils/typechecker#readme",
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
